// Prisma schema — 模具注塑报价系统
// 8 张核心表 + 1 张会话表

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. 企业租户（多租户 SaaS 模式下用）
model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  customers Customer[]
  quotes    Quote[]
  materialOverrides MaterialOverride[]
  steelOverrides    SteelOverride[]
  businessTermOverrides BusinessTermOverride[]
  complexityOverrides  ComplexityOverride[]
  customFormulas      CustomFormula[]
  materials           Material[]
  customParameters    CustomParameter[]
  quoteTemplates      QuoteTemplate[]
  moldTypes           MoldType[]
  quoteItems          QuoteItem[]
  businessTerms       BusinessTerm[]
}

// 2. 用户
model User {
  id            String   @id @default(cuid())
  companyId     String
  email         String   @unique
  passwordHash  String
  name          String
  role          UserRole @default(quoter)
  emailVerified Boolean  @default(false)  // 邮箱是否已通过验证码验证
  createdAt     DateTime @default(now())
  lastLoginAt   DateTime?

  company   Company @relation(fields: [companyId], references: [id])
  quotes    Quote[] @relation("CreatedBy")
  approved  Quote[] @relation("ApprovedBy")

  @@index([companyId])
}

enum UserRole {
  quoter
  auditor
  admin
}

// 2.1 邮箱验证码（注册 / 找回密码 / 通用）
model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String   // 6 位数字
  scene     String   // 'register' | 'reset_password'
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, scene, createdAt])
  @@index([email, scene, used])
}

// 2.2 报价单邮件发送记录（客户报价单通知留痕）
model QuoteEmailLog {
  id        String   @id @default(cuid())
  quoteId   String
  versionId String?
  toEmail   String
  subject   String
  status    String   // 'sent' | 'failed'
  errorMsg  String?
  sentById  String?
  createdAt DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id])

  @@index([quoteId, createdAt])
}

// 3. 客户库
model Customer {
  id           String   @id @default(cuid())
  companyId    String
  code         String?  // 客户编号
  name         String
  contactName  String?
  email        String?  // 客户邮箱（发报价单用）
  phone        String?
  address      String?
  industry     String?
  size         String?  // 大型企业 / 中小企业 / 个体
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  quotes  Quote[]

  @@index([companyId, name])
  @@index([companyId, phone])
  @@index([companyId, email])
}

// 4. 报价单（仅最新版本指针 + 基础信息）
model Quote {
  id              String   @id @default(cuid())
  companyId       String
  customerId      String?
  moldTypeId      String?  // 配置中心的模具类型（新流程）
  createdById     String
  approvedById    String?
  quoteNo         String   @unique  // BJ-2026-0906-A02
  status          QuoteStatus @default(draft)
  effectiveDays   Int      @default(30)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sentAt          DateTime?
  confirmedAt     DateTime?

  company     Company  @relation(fields: [companyId], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id])
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])
  approvedBy  User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  versions    QuoteVersion[]
  shares      QuoteShare[]
  logs        QuoteLog[]
  emailLogs   QuoteEmailLog[]
  adjustments QuoteAdjustment[]

  @@index([companyId, status])
  @@index([companyId, createdById, createdAt])
  @@index([companyId, customerId])
}

enum QuoteStatus {
  draft
  pending
  approved
  rejected
  sent
  confirmed
  lost
  void
  expired
}

// 5. 报价单版本快照（核心：所有参数 + 计算结果存 JSON）
model QuoteVersion {
  id            String   @id @default(cuid())
  quoteId       String
  versionNo     Int      // 1, 2, 3...
  parentVersionId String?
  paramsJson    Json     // 所有输入参数
  calcResultJson Json    // 所有计算结果 + 公式
  businessTermsJson Json // 商务条款覆盖
  createdAt     DateTime @default(now())
  createdById   String?
  changeNote    String?  // 修改说明

  quote      Quote @relation(fields: [quoteId], references: [id])
  parent     QuoteVersion? @relation("ParentVersion", fields: [parentVersionId], references: [id])
  children   QuoteVersion[] @relation("ParentVersion")

  @@unique([quoteId, versionNo])
  @@index([quoteId])
}

// 6. 报价单分享（客户视图）
model QuoteShare {
  id          String   @id @default(cuid())
  quoteId     String
  versionId   String
  shareToken  String   @unique
  email       String   // 客户邮箱
  expiresAt   DateTime
  accessedAt  DateTime?
  confirmedAt DateTime?

  quote Quote @relation(fields: [quoteId], references: [id])

  @@index([quoteId])
}

// 7. 操作日志
model QuoteLog {
  id        String   @id @default(cuid())
  quoteId   String
  userId    String?
  action    String   // 'created' / 'edited' / 'submitted' / 'approved' / 'rejected' / 'sent' / 'confirmed'
  detail    String?
  createdAt DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id])

  @@index([quoteId, createdAt])
}

// 8. 企业参数覆盖（每个企业可覆盖平台默认值）
model MaterialOverride {
  id        String @id @default(cuid())
  companyId String
  key       String  // ABS / PP / ...
  unitPrice Float

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model SteelOverride {
  id         String @id @default(cuid())
  companyId  String
  key        String
  unitPrice  Float
  coeff      Float  @default(1.0)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model ComplexityOverride {
  id        String @id @default(cuid())
  companyId String
  level     String  // simple / medium / complex / ultra_precision
  coeff     Float

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, level])
}

model BusinessTermOverride {
  id        String @id @default(cuid())
  companyId String
  index     Int
  enabled   Boolean @default(true)
  text      String

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, index])
}

// 9. 报价项中心 — 用户自定义报价项（含公式 / 条件 / 测试发布）
// 对应 PRD：P3 报价项 + P7 公式引擎 + P8 条件 + P9 测试发布
model CustomFormula {
  id         String   @id @default(cuid())
  companyId  String
  code       String?  // 报价项编码，公式中可用 {code} 引用其它项（计算链）
  name       String   // 报价项名（"热流道费"、"试模加次"）
  category   String   @default("自定义") // 材料费/模架/CNC/EDM/线切割/热流道/滑块/镶件/试模/表面处理/包装/运输/人工/管理费/利润/税费/自定义
  scope      String   // 'mold' | 'injection' | 'summary'  计入哪类合计
  unit       String?  // 单位：元 / 元每件
  expression String   // DSL 表达式：数字、+ - * / ( )、函数 max/min/round/if、变量 {cavityCount}、引用其它公式 {heatRunnerFee}
  condition  String?  // 条件表达式，为空或求值为真时才计入（支持 IF/AND/OR/比较）
  // P9：测试通过才能启用
  enabled    Boolean  @default(false)
  tested     Boolean  @default(false)
  lastTestAt DateTime?
  lastTestResult String?
  version    Int      @default(1)
  sortOrder  Int      @default(0)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, scope, sortOrder])
  @@unique([companyId, scope, name])
}

// 10. 材料中心 — 企业材料库（对应 PRD P5 + P6）
model Material {
  id           String   @id @default(cuid())
  companyId    String
  code         String   // 材料编码
  name         String   // ABS / PP / PC ...
  category     String   @default("塑料原料") // 塑料原料 / 模具钢材 / 辅料
  unit         String   @default("kg")      // g / kg / t / 件
  density      Float?   // g/cm3
  lossRate     Float    @default(0.05)      // 损耗率
  currentPrice Float    @default(0)         // 当前单价（元/unit）
  currency     String   @default("CNY")
  priceRule    String   @default("fixed")   // fixed 固定价 / tiered 阶梯价
  priceTiers   String?                      // JSON: [{minQty, maxQty, price}]
  remark       String?
  isPreset     Boolean  @default(false)     // 系统预置材料
  enabled      Boolean  @default(true)
  moldTypeId   String?                      // 归属模具类型（空=全公司通用）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  moldType MoldType? @relation(fields: [moldTypeId], references: [id], onDelete: Cascade)
  prices   MaterialPrice[]

  @@unique([companyId, moldTypeId, code])
  @@index([companyId, category])
}

// 材料价格版本（PRD 3.7：改价形成新版本，历史报价沿用旧版本）
model MaterialPrice {
  id            String   @id @default(cuid())
  materialId    String
  version       Int
  price         Float
  effectiveFrom DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, version])
  @@index([materialId])
}

// 11. 参数中心（对应 PRD P4）
model CustomParameter {
  id           String   @id @default(cuid())
  companyId    String
  code         String   // 参数编码，公式中用 {code} 引用
  name         String
  type         String   @default("decimal") // text|int|decimal|money|percent|select|multiselect|switch|date
  unit         String?
  defaultValue String?
  required     Boolean  @default(false)
  options      String?  // JSON 数组，用于 select / multiselect
  min          Float?
  max          Float?
  group        String   @default("通用") // 模具参数 / 注塑参数 / 商务参数 / 通用
  sortOrder    Int      @default(0)
  enabled      Boolean  @default(true)
  remark       String?
  moldTypeId   String?  // 归属模具类型（空=全公司通用）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  moldType MoldType? @relation(fields: [moldTypeId], references: [id], onDelete: Cascade)

  @@unique([companyId, moldTypeId, code])
  @@index([companyId, group, sortOrder])
}

// 12. 报价模板（对应 PRD P10）
model QuoteTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  itemCodes   String   // JSON 数组：选中的报价项 code，按顺序
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, name])
}

// 13. 人工调整留痕（对应 PRD 5.6 / P12）
model QuoteAdjustment {
  id            String   @id @default(cuid())
  quoteId       String
  versionNo     Int
  field         String   // 被调整的报价项/字段
  systemValue   Float    // 系统计算值
  adjustedValue Float    // 人工调整值
  reason        String?
  createdById   String?
  createdAt     DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, versionNo])
}

// 14. 模具类型（注塑 / 压铸 / 双色 / 冲压 / 自定义…）
model MoldType {
  id        String   @id @default(cuid())
  companyId String
  code      String   // injection / diecast / twocolor / 自定义
  name      String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  isPreset  Boolean  @default(false)
  profitRate Float   @default(0.10)  // 利润率
  taxRate    Float   @default(0.13)  // 税率
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id])
  items      QuoteItem[]
  parameters CustomParameter[]
  materials  Material[]
  terms      BusinessTerm[]

  @@unique([companyId, code])
  @@index([companyId, sortOrder])
}

// 15. 费用项 — 由「计算方式 + 填的数字」驱动，公式由系统生成
model QuoteItem {
  id         String   @id @default(cuid())
  companyId  String
  moldTypeId String
  name       String
  category   String   @default("自定义")
  scope      String   @default("mold")   // mold | injection
  calcType   String   @default("fixed")  // fixed|qty|size|hours|weight|percent|manual|formula
  calcConfig Json?                       // 各计算方式的填空
  expression String?                     // 仅 formula 模式使用
  unit       String?
  enabled    Boolean  @default(true)
  sortOrder  Int      @default(0)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  moldType MoldType @relation(fields: [moldTypeId], references: [id], onDelete: Cascade)

  @@index([companyId, moldTypeId, sortOrder])
}

// 16. 商务条款（按模具类型隔离）
model BusinessTerm {
  id         String   @id @default(cuid())
  companyId  String
  moldTypeId String
  text       String
  enabled    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id])
  moldType MoldType @relation(fields: [moldTypeId], references: [id], onDelete: Cascade)

  @@index([companyId, moldTypeId, sortOrder])
}
