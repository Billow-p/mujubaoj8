FROM node:20-alpine AS base
WORKDIR /app

# 安装依赖
FROM base AS deps
COPY packages/shared/package.json packages/shared/
COPY packages/calc-engine/package.json packages/calc-engine/
COPY apps/api/package.json apps/api/
COPY package.json pnpm-workspace.yaml* ./
RUN corepack enable && pnpm install --frozen-lockfile

# 构建
FROM deps AS build
COPY packages/shared packages/shared
COPY packages/calc-engine packages/calc-engine
COPY apps/api apps/api
RUN pnpm --filter @mqs/shared build
RUN pnpm --filter @mqs/calc-engine build
RUN pnpm --filter @mqs/api prisma generate
RUN pnpm --filter @mqs/api build

# 运行
FROM base AS run
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/api/prisma apps/api/prisma
COPY --from=build /app/apps/api/node_modules apps/api/node_modules
COPY --from=build /app/packages/shared packages/shared
COPY --from=build /app/packages/calc-engine packages/calc-engine
COPY --from=build /app/node_modules node_modules

WORKDIR /app/apps/api
EXPOSE 3000
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
