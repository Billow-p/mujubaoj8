{
  "name": "mold-quote-system",
  "version": "0.1.0",
  "private": true,
  "description": "模具注塑行业报价系统",
  "scripts": {
    "dev:api": "pnpm --filter @mqs/api dev",
    "dev:web": "pnpm --filter @mqs/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @mqs/api prisma migrate dev",
    "db:seed": "pnpm --filter @mqs/api prisma db seed",
    "db:studio": "pnpm --filter @mqs/api prisma studio"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.7"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
